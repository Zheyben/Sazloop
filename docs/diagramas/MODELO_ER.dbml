// MealFlow - Modelo ER completo (primer avance)
// Pegar TODO este archivo en https://dbdiagram.io

// -------------------- Identidad --------------------
Table usuario {
  id bigint [pk, increment]
  email varchar(180) [not null, unique]
  password_hash varchar(255) [not null]
  nombre varchar(120) [not null]
  apellido varchar(120)
  telefono varchar(30)
  activo boolean [not null, default: true]
  creado_en datetime [not null]
}

Table consumidor {
  id bigint [pk, increment]
  usuario_id bigint [not null, unique, ref: > usuario.id]
}

Table propietario_empresa {
  id bigint [pk, increment]
  usuario_id bigint [not null, unique, ref: > usuario.id]
}

Table empresa {
  id bigint [pk, increment]
  propietario_empresa_id bigint [not null, ref: > propietario_empresa.id]
  razon_social varchar(200) [not null]
  nombre_comercial varchar(200)
  ruc varchar(20) [not null, unique]
  telefono varchar(30)
  email_corporativo varchar(180)
  creado_en datetime [not null]
}

Table establecimiento {
  id bigint [pk, increment]
  empresa_id bigint [not null, ref: > empresa.id]
  nombre varchar(200) [not null]
  tipo varchar(80)
  estado varchar(40) [not null, note: 'PENDIENTE, APROBADO, RECHAZADO, SUSPENDIDO']
  qr_enlace varchar(255)
  creado_en datetime [not null]
}

Table direccion {
  id bigint [pk, increment]
  establecimiento_id bigint [not null, unique, ref: > establecimiento.id]
  distrito varchar(120) [not null]
  calle varchar(200) [not null]
  numero varchar(30)
  referencia varchar(255)
}

Table cuenta_establecimiento {
  id bigint [pk, increment]
  establecimiento_id bigint [not null, unique, ref: > establecimiento.id]
  usuario_acceso varchar(80) [not null, unique]
  password_hash varchar(255) [not null]
  activa boolean [not null, default: true]
  creada_en datetime [not null]
}

// -------------------- Afiliacion --------------------
Table administrador_plataforma {
  id bigint [pk, increment]
  usuario_id bigint [not null, unique, ref: > usuario.id]
}

Table solicitud_afiliacion {
  id bigint [pk, increment]
  establecimiento_id bigint [not null, ref: > establecimiento.id]
  estado varchar(40) [not null, note: 'PENDIENTE, APROBADA, RECHAZADA']
  enviada_en datetime [not null]
  observaciones text
}

Table documento_establecimiento {
  id bigint [pk, increment]
  solicitud_afiliacion_id bigint [not null, ref: > solicitud_afiliacion.id]
  establecimiento_id bigint [not null, ref: > establecimiento.id]
  tipo varchar(80) [not null]
  numero varchar(80)
  ruta_archivo varchar(255) [not null]
  emitido_en date
  vence_en date
  estado varchar(40) [not null]
}

Table revision_documento {
  id bigint [pk, increment]
  documento_establecimiento_id bigint [not null, ref: > documento_establecimiento.id]
  administrador_plataforma_id bigint [not null, ref: > administrador_plataforma.id]
  resultado varchar(40) [not null]
  observaciones text
  revisado_en datetime [not null]
}

Table evaluacion_afiliacion {
  id bigint [pk, increment]
  solicitud_afiliacion_id bigint [not null, unique, ref: > solicitud_afiliacion.id]
  administrador_plataforma_id bigint [not null, ref: > administrador_plataforma.id]
  resultado varchar(40) [not null]
  motivo text
  evaluada_en datetime [not null]
}

Table suspension_establecimiento {
  id bigint [pk, increment]
  establecimiento_id bigint [not null, ref: > establecimiento.id]
  motivo varchar(255) [not null]
  iniciada_en datetime [not null]
  finalizada_en datetime
  activa boolean [not null, default: true]
}

// -------------------- Ofertas --------------------
Table pack_sorpresa {
  id bigint [pk, increment]
  establecimiento_id bigint [not null, ref: > establecimiento.id]
  titulo varchar(160) [not null]
  descripcion text
  ejemplos_productos text
  activo boolean [not null, default: true]
}

Table oferta_pack {
  id bigint [pk, increment]
  pack_sorpresa_id bigint [not null, ref: > pack_sorpresa.id]
  fecha_vigencia date [not null]
  hora_inicio_recojo varchar(8) [not null]
  hora_fin_recojo varchar(8) [not null]
  hora_limite varchar(8) [not null]
  estado varchar(40) [not null, note: 'ACTIVA, CERRADA, CANCELADA']
  publicada_en datetime [not null]
}

Table variante_pack {
  id bigint [pk, increment]
  oferta_pack_id bigint [not null, ref: > oferta_pack.id]
  tamanio varchar(40) [not null, note: 'PEQUENO, MEDIANO, GRANDE']
  precio_referencial decimal(10,2) [not null]
  precio_descuento decimal(10,2) [not null]
  stock_inicial int [not null]
  stock_disponible int [not null]
}

Table alergeno {
  id bigint [pk, increment]
  nombre varchar(80) [not null, unique]
  descripcion varchar(255)
}

Table restriccion_alimentaria {
  id bigint [pk, increment]
  nombre varchar(80) [not null, unique]
  descripcion varchar(255)
}

Table pack_alergeno {
  pack_sorpresa_id bigint [not null, ref: > pack_sorpresa.id]
  alergeno_id bigint [not null, ref: > alergeno.id]

  indexes {
    (pack_sorpresa_id, alergeno_id) [pk]
  }
}

Table pack_restriccion {
  pack_sorpresa_id bigint [not null, ref: > pack_sorpresa.id]
  restriccion_id bigint [not null, ref: > restriccion_alimentaria.id]

  indexes {
    (pack_sorpresa_id, restriccion_id) [pk]
  }

  Note: 'Resuelve la relacion N:M entre PackSorpresa y RestriccionAlimentaria'
}

// -------------------- Reservas / transacciones / experiencia --------------------
Table retencion_stock {
  id bigint [pk, increment]
  variante_pack_id bigint [not null, ref: > variante_pack.id]
  consumidor_id bigint [not null, ref: > consumidor.id]
  cantidad int [not null]
  expira_en datetime [not null]
  estado varchar(40) [not null]
}

Table reserva {
  id bigint [pk, increment]
  consumidor_id bigint [not null, ref: > consumidor.id]
  oferta_pack_id bigint [not null, ref: > oferta_pack.id]
  estado varchar(40) [not null, note: 'CONFIRMADA, PENDIENTE_RECOJO, RECOGIDA, CANCELADA, EXPIRADA']
  total decimal(10,2) [not null]
  creada_en datetime [not null]
}

Table detalle_reserva {
  id bigint [pk, increment]
  reserva_id bigint [not null, ref: > reserva.id]
  variante_pack_id bigint [not null, ref: > variante_pack.id]
  cantidad int [not null]
  precio_unitario decimal(10,2) [not null]
  subtotal decimal(10,2) [not null]
}

Table pago {
  id bigint [pk, increment]
  reserva_id bigint [not null, unique, ref: > reserva.id]
  metodo varchar(40) [not null, note: 'TARJETA_DEBITO, YAPE, EFECTIVO']
  contexto varchar(40) [not null, note: 'REMOTO, PRESENCIAL']
  monto decimal(10,2) [not null]
  estado varchar(40) [not null]
  pagado_en datetime
}

Table boleta_simulada {
  id bigint [pk, increment]
  reserva_id bigint [not null, unique, ref: > reserva.id]
  numero varchar(40) [not null, unique]
  emitida_en datetime [not null]
  resumen text
}

Table codigo_recojo {
  id bigint [pk, increment]
  reserva_id bigint [not null, unique, ref: > reserva.id]
  codigo varchar(40) [not null, unique]
  utilizado boolean [not null, default: false]
  generado_en datetime [not null]
}

Table recojo {
  id bigint [pk, increment]
  reserva_id bigint [not null, unique, ref: > reserva.id]
  cuenta_establecimiento_id bigint [not null, ref: > cuenta_establecimiento.id]
  confirmado_en datetime [not null]
}

Table cancelacion_reserva {
  id bigint [pk, increment]
  reserva_id bigint [not null, unique, ref: > reserva.id]
  motivo varchar(255)
  penalizacion_pct decimal(5,2) [not null]
  cancelada_en datetime [not null]
}

Table reembolso {
  id bigint [pk, increment]
  cancelacion_reserva_id bigint [not null, unique, ref: > cancelacion_reserva.id]
  monto decimal(10,2) [not null]
  estado varchar(40) [not null]
  procesado_en datetime
}

Table comision_plataforma {
  id bigint [pk, increment]
  reserva_id bigint [not null, ref: > reserva.id]
  base_cobrada decimal(10,2) [not null]
  porcentaje decimal(5,2) [not null, default: 10]
  monto decimal(10,2) [not null]
  registrada_en datetime [not null]
}

Table resena {
  id bigint [pk, increment]
  reserva_id bigint [not null, unique, ref: > reserva.id]
  consumidor_id bigint [not null, ref: > consumidor.id]
  establecimiento_id bigint [not null, ref: > establecimiento.id]
  calificacion int [not null, note: '1 a 5']
  comentario text
  creada_en datetime [not null]
}

Table notificacion {
  id bigint [pk, increment]
  usuario_id bigint [not null, ref: > usuario.id]
  titulo varchar(160) [not null]
  mensaje text [not null]
  leida boolean [not null, default: false]
  creada_en datetime [not null]
}

Table impacto_co2_evitado {
  id bigint [pk, increment]
  recojo_id bigint [not null, unique, ref: > recojo.id]
  alimento_kg_estimado decimal(10,3)
  co2_kg_estimado decimal(10,3)
  registrado_en datetime [not null]

  Note: 'Formula conceptual en esta version academica'
}
